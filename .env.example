DATABASE_URL="postgresql://user:password@localhost:5432/alentour?schema=public"

# openssl rand -hex 32
JWT_SECRET="change-me"

# Base du lien envoye dans l'email de reinitialisation de mot de passe.
# Provisoire tant que la cible reelle (deep link mobile vs page web) n'est
# pas tranchee cote app.
APP_URL="http://localhost:8081"

# Envoi reel des emails de reinitialisation via Brevo. Non definie : le
# lien est simplement ecrit dans les logs (comportement par defaut en dev).
# Domaine expediteur a verifier dans le compte Brevo avant toute prod.
BREVO_API_KEY=""
BREVO_EXPEDITEUR_EMAIL="noreply@alentour.ci"
BREVO_EXPEDITEUR_NOM="Alentour"
