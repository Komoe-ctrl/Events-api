# Modele pour .env.test.local (ignore par git, comme .env.local) — a copier
# et completer avec vos propres identifiants Postgres locaux.
#
# DATABASE_URL doit pointer vers une base DEDIEE AUX TESTS, jamais celle de
# dev ni de prod : la suite e2e tronque toutes les tables entre chaque test
# (voir test/helpers/db.ts). Creez une base separee, ex. "alentour_test",
# sur la meme instance Postgres que votre base de dev.
DATABASE_URL="postgresql://user:password@localhost:5432/alentour_test?schema=public"

# Secret de signature JWT pour les tests — sans rapport avec celui de
# prod/dev, peut rester une valeur fixe ici (pas un vrai secret a proteger).
JWT_SECRET="secret-de-test-e2e-jamais-utilise-en-production"

# BREVO_API_KEY volontairement vide : les emails de reinitialisation sont
# simplement journalises plutot qu'envoyes (comportement par defaut, voir
# .env.example). Aucun appel reseau externe pendant les tests.
BREVO_API_KEY=""
BREVO_EXPEDITEUR_EMAIL="noreply@alentour.ci"
BREVO_EXPEDITEUR_NOM="Alentour"
APP_URL="http://localhost:8081"
CORS_ORIGINS=""
