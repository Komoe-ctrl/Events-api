generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleUtilisateur {
  PARTICIPANT
  ORGANISATEUR
  ADMIN
}

enum CategorieEvenement {
  CONCERT
  SOIREE
  CONFERENCE
  SPORT
  CULTURE
  RELIGIEUX
}

enum StatutEvenement {
  BROUILLON
  EN_ATTENTE
  PUBLIE
  REFUSE
}

enum StatutReservation {
  CONFIRMEE
  ANNULEE
  UTILISEE
}

model Utilisateur {
  id             String          @id @default(cuid())
  nom            String
  telephone      String          @unique
  email          String          @unique
  motDePasseHash String
  role           RoleUtilisateur @default(PARTICIPANT)
  createdAt      DateTime        @default(now())

  evenements             Evenement[]
  reservations           Reservation[]
  tokensReinitialisation TokenReinitialisation[]
}

// Jeton de reinitialisation de mot de passe. Interne a l'API, jamais
// serialise vers le mobile — ne fait pas partie du contrat de donnees
// partage (CLAUDE.md), contrairement a Utilisateur/Evenement/Reservation.
model TokenReinitialisation {
  id            String    @id @default(cuid())
  utilisateurId String
  // Hash SHA-256 du jeton, jamais le jeton en clair (regle de domaine :
  // securite). Rapide plutot qu'argon2 : le jeton est une valeur aleatoire
  // a haute entropie generee par le serveur, pas un mot de passe choisi par
  // un humain — pas besoin d'un hachage lent pour resister au brute-force.
  tokenHash String    @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Compte les demandes recentes d'un utilisateur (limitation des
  // tentatives) et retrouve/invalide ses jetons non utilises.
  @@index([utilisateurId])
}

model Evenement {
  id                  String             @id @default(cuid())
  titre               String
  slug                String             @unique
  description         String
  image               String
  categorie           CategorieEvenement
  dateDebut           DateTime
  dateFin             DateTime?
  prix                Int?
  capacite            Int?
  latitude            Float
  longitude           Float
  adresse             String
  commune             String
  statut              StatutEvenement    @default(BROUILLON)
  motifRefus          String?
  organisateurId      String
  contactOrganisateur String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organisateur Utilisateur   @relation(fields: [organisateurId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  // Bounding box pour la recherche geolocalisee (regle de domaine n.1) : filtre
  // par plage lat/lng avant le calcul haversine en $queryRaw.
  @@index([latitude, longitude])
  // File de moderation (statut = EN_ATTENTE) et listing public (statut = PUBLIE),
  // tries/filtres par date dans les deux cas.
  @@index([statut, dateDebut])
  // GET /moi/evenements : toutes les publications d'un organisateur, tous statuts.
  @@index([organisateurId])
}

model Reservation {
  id            String            @id @default(cuid())
  evenementId   String
  utilisateurId String
  nombrePlaces  Int               @default(1)
  code          String            @unique
  statut        StatutReservation @default(CONFIRMEE)
  createdAt     DateTime          @default(now())
  utiliseeLe    DateTime?

  evenement   Evenement   @relation(fields: [evenementId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  // NOTE : la regle "une seule reservation active par utilisateur et par evenement"
  // (regle de domaine n.4) n'est PAS entierement portee par ce schema. Prisma ne
  // sait pas exprimer d'index unique partiel (WHERE ...). Elle sera ajoutee a la
  // main dans la migration generee :
  //   CREATE UNIQUE INDEX reservation_active_unique
  //     ON "Reservation" ("evenementId", "utilisateurId")
  //     WHERE statut IN ('CONFIRMEE', 'UTILISEE');
  // Voir l'explication complete dans la conversation au moment de la migration.

  // GET /moi/reservations
  @@index([utilisateurId])
  // Verification de capacite dans la transaction de reservation (regle n.3)
  @@index([evenementId, statut])
}
